{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discord-hero.local/schemas/agent-task.schema.json",
  "title": "Discord Hero AI coding task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "objective",
    "risk",
    "constraints",
    "acceptanceCriteria",
    "requiredChecks",
    "allowedPaths",
    "forbiddenPaths"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "risk": {
      "enum": ["low", "medium", "high"]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "verification": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "enum": ["format", "lint", "typecheck", "test", "build", "agent-smoke", "db-migrate-local"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "forbiddenPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
