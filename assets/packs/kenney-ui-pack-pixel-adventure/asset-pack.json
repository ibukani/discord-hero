  "schemaVersion": 1,
  "id": "kenney-ui-pack-pixel-adventure",
  "version": "2.0",
  "displayName": "UI Pack - Pixel Adventure",
  "description": "Kenney Pixel Adventure UI Pack (500+ pixel UI assets, tiles, frames, buttons, and icons).",
