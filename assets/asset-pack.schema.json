{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discord-hero.local/schemas/asset-pack.schema.json",
  "title": "Discord Hero asset pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "environments",
    "required",
    "ownership",
    "license",
    "source",
    "delivery",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "environments": {
      "type": "array",
      "items": {
        "enum": ["local", "staging", "production"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required": {
      "type": "boolean"
    },
    "ownership": {
      "enum": ["project", "third-party", "generated"]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "redistribution",
        "modification",
        "repositoryPolicy",
        "deploymentPolicy",
        "attributionRequired"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spdx": {
          "type": ["string", "null"]
        },
        "sourceUrl": {
          "type": "string"
        },
        "redistribution": {
          "enum": ["allowed", "prohibited", "unknown"]
        },
        "modification": {
          "enum": ["allowed", "prohibited", "unknown"]
        },
        "repositoryPolicy": {
          "enum": ["allowed", "git-lfs-only", "forbidden"]
        },
        "attributionRequired": {
          "type": "boolean"
        },
        "attributionText": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "deploymentPolicy": {
          "enum": ["allowed", "local-only", "prohibited", "unknown"]
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "directory"],
          "properties": {
            "kind": {
              "const": "repository"
            },
            "directory": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "directory"],
          "properties": {
            "kind": {
              "const": "git-lfs"
            },
            "directory": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "directory"],
          "properties": {
            "kind": {
              "const": "local-directory"
            },
            "directory": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "archiveNames", "archiveRoot", "sha256"],
          "properties": {
            "kind": {
              "const": "local-archive"
            },
            "archiveNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "archiveRoot": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "archiveRoot", "sha256"],
          "properties": {
            "kind": {
              "const": "remote-archive"
            },
            "url": {
              "type": "string"
            },
            "archiveRoot": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "external"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "directory"],
          "properties": {
            "kind": {
              "const": "generated"
            },
            "directory": {
              "type": "string"
            }
          }
        }
      ]
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "publicPath"],
          "properties": {
            "kind": {
              "const": "bundle"
            },
            "publicPath": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseUrl"],
          "properties": {
            "kind": {
              "const": "external"
            },
            "baseUrl": {
              "type": "string"
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mediaType", "sourcePath", "outputPath"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "kind": {
          "enum": ["image", "sprite-sheet", "audio", "font", "data", "binary"]
        },
        "mediaType": {
          "type": "string",
          "minLength": 3
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "externalUrl": {
          "type": "string"
        },
        "pixelArt": {
          "type": "boolean"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "spriteSheet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frameWidth",
            "frameHeight",
            "frameCount",
            "columns",
            "rows",
            "frameDurationMs",
            "loop",
            "anchor"
          ],
          "properties": {
            "frameWidth": {
              "type": "integer",
              "minimum": 1
            },
            "frameHeight": {
              "type": "integer",
              "minimum": 1
            },
            "frameCount": {
              "type": "integer",
              "minimum": 1
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "frameDurationMs": {
              "type": "integer",
              "minimum": 1
            },
            "loop": {
              "type": "boolean"
            },
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "weight", "style"],
          "properties": {
            "family": {
              "type": "string"
            },
            "weight": {
              "type": "string"
            },
            "style": {
              "type": "string"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format"],
          "properties": {
            "format": {
              "enum": ["json", "text", "csv", "other"]
            }
          }
        }
      }
    }
  }
}
