{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@cloudflare/vitest-pool-workers/types", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/worker/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
