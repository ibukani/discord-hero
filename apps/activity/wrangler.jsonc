{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "discord-hero-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "secrets": {
    "required": ["DISCORD_CLIENT_SECRET", "SESSION_SIGNING_SECRET"],
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "APP_ENV": "local",
    "ALLOW_LOCAL_AUTH": "true",
    "DISCORD_CLIENT_ID": "local-discord-client",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom",
      },
    ],
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-hero-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MATCH_RESULTS_QUEUE",
        "queue": "discord-hero-results-local",
      },
    ],
    "consumers": [
      {
        "queue": "discord-hero-results-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "discord-hero-results-local-dlq",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "discord-hero-staging",
      "secrets": {
        "required": ["DISCORD_CLIENT_SECRET", "SESSION_SIGNING_SECRET"],
      },
      "vars": {
        "APP_ENV": "staging",
        "ALLOW_LOCAL_AUTH": "false",
        "DISCORD_CLIENT_ID": "1530495701992341554",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOMS",
            "class_name": "GameRoom",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "discord-hero-staging",
          "database_id": "da9b7863-1c23-4209-a1d9-f6db6ef20dc5",
          "migrations_dir": "../../migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "10002",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "MATCH_RESULTS_QUEUE",
            "queue": "discord-hero-results-staging",
          },
        ],
        "consumers": [
          {
            "queue": "discord-hero-results-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "discord-hero-results-staging-dlq",
          },
        ],
      },
    },
    "production": {
      "name": "discord-hero-production",
      "secrets": {
        "required": ["DISCORD_CLIENT_SECRET", "SESSION_SIGNING_SECRET"],
      },
      "vars": {
        "APP_ENV": "production",
        "ALLOW_LOCAL_AUTH": "false",
        "DISCORD_CLIENT_ID": "1530495701992341554",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOMS",
            "class_name": "GameRoom",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "discord-hero-production",
          "database_id": "534e9e9c-3a9d-4566-93a2-824e9941d3b1",
          "migrations_dir": "../../migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "10003",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "MATCH_RESULTS_QUEUE",
            "queue": "discord-hero-results-production",
          },
        ],
        "consumers": [
          {
            "queue": "discord-hero-results-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "discord-hero-results-production-dlq",
          },
        ],
      },
    },
  },
}
